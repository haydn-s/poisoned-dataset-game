# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud's
# app Settings > Secrets. The real secrets.toml is ignored by Git.
[playtesting]
repository = "haydn-s/poisoned-dataset-game"
directory = "playtests"
# All archive writes use the play-testing branch, never the app's source branch.
# Fine-grained PAT: only this repository; Contents permission = Read and write.
github_token = ""
# Optional absolute directory for local JSON copies (default: beside the DB).
# local_directory = "/persistent/playtest-archive"
